# ==============================================
# CoT Data Visualization Platform
# Unified Environment Configuration
# ==============================================

# --- Railway Auto-Injected (Production) ---
# DATABASE_URL - Automatically provided by Railway PostgreSQL
# PORT - Automatically set by Railway
# RAILWAY_ENVIRONMENT - Set by Railway (production/staging)

# --- Database ---
DATABASE_URL=postgresql://cot_user:dev_password@localhost:5432/cot_db

# --- Redis (Optional - for job scheduling) ---
REDIS_URL=redis://localhost:6379

# --- Server Configuration ---
PORT=3001
NODE_ENV=development

# --- Security ---
# Signs the app's own session token, issued after eccuity OAuth login.
JWT_SECRET=dev-secret-change-in-production-use-random-string

# --- eccuity OAuth (login) ---
# The CoT app is an OAuth client of eccuity (authorization_code + PKCE).
# Login + the anonymous data gate stay DORMANT until ECCUITY_CLIENT_ID is set,
# so the app behaves exactly as before until you fill these in.
ECCUITY_OAUTH_ISSUER=https://api.eccuity.com
ECCUITY_CLIENT_ID=
# Optional — only if eccuity issues a confidential client (default is public/PKCE).
ECCUITY_CLIENT_SECRET=
# Public origin used to build the OAuth redirect_uri (must be allowlisted in
# eccuity). Prod: https://cot.eccuity.com  Dev: http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
# Signs the short-lived OAuth state/PKCE cookies. Use a strong random value in prod.
COOKIE_SECRET=dev-cookie-secret-change-in-production
# Anonymous users only see the most recent N weeks of history/prices.
AUTH_RECENT_WINDOW_WEEKS=52

# --- App Password Protection (Optional) ---
# Leave empty to disable password protection
# Set a password to require HTTP Basic Auth for the entire app
# Example: APP_PASSWORD=mySecurePassword123
APP_PASSWORD=

# --- Frontend URL (for CORS) ---
FRONTEND_URL=http://localhost:3000

# --- CFTC API ---
CFTC_API_BASE=https://publicreporting.cftc.gov/api/

# --- EOD Historical Data (eodhistoricaldata.com) ---
# Required for asset price overlay on charts
EOD_API_KEY=your_eod_api_key_here

# --- Job Scheduler ---
# The app runs an in-app scheduler that automatically refreshes CoT data.
# Cron expression (UTC). Default is daily at 21:00 UTC; CFTC publishes new
# reports every Friday ~20:30 UTC. The fetch is idempotent, so daily runs on
# days with no new report are a cheap no-op.
DATA_FETCH_CRON=0 21 * * *
# Enable the scheduler. Defaults to true in production, false in development.
# Set to true to test the automatic refresh locally.
ENABLE_SCHEDULER=false

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3001
